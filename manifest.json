{
  "$schema": "https://json.schemastore.org/web-manifest.json",
  "id": "/",
  "name": "Mujeeb Fleet & Multi-Ledger Manager",
  "short_name": "Mujeeb Fleet",
  "description": "A secure, multi-device cloud fleet and multi-ledger management application.",
  "start_url": "/",
